# Puerto en el que escucha Node.js (Namecheap / Phusion Passenger asigna PORT automaticamente)
PORT=3000

# Carpeta del frontend compilado (subida desde npm run build)
DIST_DIR=dist

# Limite bajo de conexiones MySQL para hosting compartido con poca RAM
DB_POOL_LIMIT=3
DB_SUB_POOL_LIMIT=2

# Host comun por defecto en Namecheap cPanel (normalmente localhost)
DB_HOST=localhost
DB_PORT=3306

# Base de datos principal (Dooplex)
DOOPLEX_DB_HOST=localhost
DOOPLEX_DB_PORT=3306
DOOPLEX_DB_NAME=tu_usuario_dooplex
DOOPLEX_DB_USER=tu_usuario_dooplex
DOOPLEX_DB_PASSWORD=tu_password_mysql

# Base de datos Docines (opcional, si la usas)
DOCINES_DB_HOST=localhost
DOCINES_DB_PORT=3306
DOCINES_DB_NAME=tu_usuario_docines
DOCINES_DB_USER=tu_usuario_docines
DOCINES_DB_PASSWORD=tu_password_mysql

# Base de datos PlusMovie (opcional, si la usas)
PLUSMOVIE_DB_HOST=localhost
PLUSMOVIE_DB_PORT=3306
PLUSMOVIE_DB_NAME=tu_usuario_plusmovie
PLUSMOVIE_DB_USER=tu_usuario_plusmovie
PLUSMOVIE_DB_PASSWORD=tu_password_mysql

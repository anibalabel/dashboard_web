{
  "version": "1.0",
  "meta": {
    "versioning_format": "X.X",
    "restriccion": "Cada X debe ser un único dígito entre 0 y 9",
    "regex": "^[0-9]\\.[0-9]$",
    "ejemplos_validos": ["2.9", "3.0", "5.4", "0.0", "9.9", "1.0"],
    "ejemplos_invalidos": ["1.10", "10.0", "1.a", "a.1", "1.", ".1"]
  }
}
